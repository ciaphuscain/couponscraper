{
  "manifest_version": 3,
  "name": "CouponHunter (personal)",
  "version": "0.1.0",
  "description": "Shows the lowest realistic price for the amazon.in product you're viewing, using your local CouponHunter backend.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.in/dp/*",
        "https://www.amazon.in/*/dp/*",
        "https://www.amazon.in/gp/product/*",
        "https://www.amazon.in/gp/aw/d/*"
      ],
      "js": ["lib.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.amazon.in/*"],
      "exclude_matches": [
        "https://www.amazon.in/dp/*", "https://www.amazon.in/*/dp/*", "https://www.amazon.in/gp/product/*",
        "https://www.amazon.in/gp/aw/d/*", "https://www.amazon.in/gp/buy/*", "https://www.amazon.in/ap/*",
        "https://www.amazon.in/gp/css/*", "https://www.amazon.in/gp/your-account/*", "https://www.amazon.in/your-account/*",
        "https://www.amazon.in/cpe/*", "https://www.amazon.in/hz/mycd/*", "https://www.amazon.in/gp/sign-in*",
        "https://www.amazon.in/checkout/*", "https://www.amazon.in/gp/help/*", "https://www.amazon.in/amazonpay/*",
        "https://www.amazon.in/gp/sva/*", "https://www.amazon.in/hfc/*"
      ],
      "js": ["lib.js", "observe.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "CouponHunter" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
